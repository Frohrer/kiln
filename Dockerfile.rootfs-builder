FROM alpine:latest

# Install required packages
RUN apk add --no-cache e2fsprogs util-linux openrc

# Create the build script
COPY <<EOF /build.sh
#!/bin/sh
set -ex

# Create the ext4 file
dd if=/dev/zero of=base.ext4 bs=1M count=200
mkfs.ext4 base.ext4

# Create mount point
mkdir -p /mnt/rootfs

# Setup loop device and mount
losetup -f base.ext4
LOOP_DEV=$(losetup -l | grep base.ext4 | cut -d' ' -f1)
mount \$LOOP_DEV /mnt/rootfs

# Set up basic system configuration
ln -s agetty /etc/init.d/agetty.ttyS0
echo ttyS0 > /etc/securetty
rc-update add agetty.ttyS0 default
rc-update add devfs boot
rc-update add procfs boot
rc-update add sysfs boot

# Copy system files to rootfs
for d in bin etc lib root sbin usr; do
    tar c "/\$d" | tar x -C /mnt/rootfs
done

# Create necessary directories
for dir in dev proc run sys var; do
    mkdir -p /mnt/rootfs/\${dir}
done

# Cleanup
umount /mnt/rootfs
losetup -d \$LOOP_DEV

# Copy to output
cp base.ext4 /output/base.ext4
EOF

RUN chmod +x /build.sh

VOLUME /output
CMD ["/build.sh"] 