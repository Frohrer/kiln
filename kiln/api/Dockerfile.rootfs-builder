FROM debian:bookworm-slim

# Install required packages
RUN apt-get update && \
    apt-get install -y \
    debootstrap \
    e2fsprogs \
    systemd-container \
    mount \
    procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Create script to build base system
RUN echo '#!/bin/bash' > /build.sh && \
    echo 'set -ex' >> /build.sh && \
    echo 'dd if=/dev/zero of=base.ext4 bs=1M count=2048' >> /build.sh && \
    echo 'mkfs.ext4 base.ext4' >> /build.sh && \
    echo 'mkdir -p /mnt/rootfs' >> /build.sh && \
    echo 'mount -o loop base.ext4 /mnt/rootfs' >> /build.sh && \
    echo 'debootstrap --variant=minbase bookworm /mnt/rootfs http://deb.debian.org/debian' >> /build.sh && \
    echo 'echo "nameserver 8.8.8.8" > /mnt/rootfs/etc/resolv.conf' >> /build.sh && \
    echo 'echo "nameserver 8.8.4.4" >> /mnt/rootfs/etc/resolv.conf' >> /build.sh && \
    echo 'chroot /mnt/rootfs apt-get clean' >> /build.sh && \
    echo 'chroot /mnt/rootfs rm -rf /var/lib/apt/lists/*' >> /build.sh && \
    echo 'umount /mnt/rootfs' >> /build.sh && \
    echo 'cp base.ext4 /output/base.ext4' >> /build.sh && \
    chmod +x /build.sh

VOLUME /output
CMD ["/build.sh"] 